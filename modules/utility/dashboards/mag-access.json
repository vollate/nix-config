      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service_name=\"mag-access\"} | json | __error__=\"\" | client_ip!=\"\" | client_ip=~`${ip:raw}` | method=~`${method:raw}` | status=~`${status:raw}` | keep client_ip [$__range]))",
          "queryType": "instant",
          "legendFormat": "",
          "editorMode": "code"
        }
      ],
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
