      "5m",
      "15m",
      "1h"
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "templating": {
    "list": [
      {
        "name": "ip",
        "label": "Client IP",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "RE2 regex, e.g. 192\\.0\\.2\\.1 or 2001:db8::.*"
      },
      {
        "name": "method",
        "label": "Method",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "RE2 regex, e.g. GET|POST"
      },
      {
        "name": "status",
        "label": "Status",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ],
        "hide": 0,
        "description": "RE2 regex, e.g. 2.. or [45].."
